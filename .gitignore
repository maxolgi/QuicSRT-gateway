# Build directories
build/
build-*/

# Fetched (not submoduled) dependency, lives inside the libwebsrt submodule
# checkout (deps/libwebsrt/deps/boringssl - ignored by its own .gitignore;
# mirrored here for symmetry)
deps/boringssl/

# Runtime-generated
cert-hash.js

# Fetched player dist (build.sh setup/web-dist) - embedded at compile time
web/dist/

# Local player override ([server].web_root disk dir) - hand-edited copy of
# web/dist the supervised gateway serves when configured; never committed
web/dist-local/

# Tooling artifacts
compile_commands.json
.cache/

# Object/archive files outside build dirs
*.o
*.a
